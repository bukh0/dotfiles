/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      WALLPAPER PICKER — GRID CONFIG                              ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */

@import "colors.rasi"

configuration {
    show-icons:                  true;
}

* {
    background-color:            transparent;
    text-color:                  @on-surface;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      WINDOW LAYOUT — centered grid, not a sidebar                ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
window {
    anchor:                      center;
    location:                    center;
    width:                       50%;
    height:                      92%;

    background-color:            @surface;
    border:                      1px;
    border-radius:               24px;
    border-color:                @outline;
}

mainbox {
    spacing:                     10px;
    padding:                     16px;
    children:                    [ "inputbar", "listview" ];
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      INPUT BAR                                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
inputbar {
    padding:                     8px 12px;
    background-color:            @surface-container-high;
    border-radius:               10px;
    children:                    [ "entry" ];
}

entry {
    placeholder:                 "Search wallpapers...";
    placeholder-color:           @on-surface-variant;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      GRID — 3 columns x 5 rows                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
listview {
    columns:                     3;
    lines:                       5;
    spacing:                     8px;
    cycle:                       true;
    fixed-height:                false;
    scrollbar:                   true;
}

scrollbar {
    width:                       4px;
    border-radius:               4px;
    handle-color:                @outline;
    handle-width:                4px;
    padding:                     0px 0px 0px 6px;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      ELEMENT STYLING                                             ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
element {
    orientation:                 vertical;
    padding:                     5px;
    border-radius:               12px;
    border:                      2px;
    border-color:                transparent;
}

element normal.normal {
    background-color:            @surface-container;
}

element alternate.normal {
    background-color:            @surface-container;
}

element selected {
    background-color:            @surface-container-highest;
    border-color:                @primary;
}

element-icon {
    size:                        130px;
    border-radius:               8px;
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

element-text {
    horizontal-align:            0.5;
    font:                        "JetBrainsMono Nerd Font 8";
    padding:                     4px 4px 0px 4px;
}

element selected element-text {
    text-color:                  @primary;
}
