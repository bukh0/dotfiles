#!/usr/bin/env python3
"""Run Quickshell regressions for staged configuration changes."""
from pathlib import Path
import subprocess
import sys

root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
paths = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '-z']).split(b'\0')
prefixes = (b'quickshell/components/', b'quickshell/profiles/', b'quickshell/native/',
            b'quickshell/picker/', b'quickshell/tests/')
if any(path.startswith(prefixes) for path in paths):
    raise SystemExit(subprocess.run([sys.executable, str(root / 'quickshell/tests/run.py')], cwd=root).returncode)
