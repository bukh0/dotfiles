/**
*/

configuration {
    terminal: "kitty";
    show-icons:         true;
    icon-theme:         "Papirus-Dark";
    font:               "JetBrainsMono Nerd Font 11";

    display-drun:       "  Apps";
    display-run:        "  Run";
    display-clipboard:  "󰅌  Clip";
    
    /* ── Neovim-Style Navigation (Alt/Ctrl + hjkl) ───────────────── */
    /* 1. Clear Rofi defaults that block hjkl and scrolling */
    kb-remove-char-back:    "BackSpace,Shift+BackSpace"; 
    kb-accept-entry:        "Return,KP_Enter";           
    kb-remove-to-eol:       "Control+shift+e";           
    kb-mode-complete:       "";                          
    kb-remove-to-sol:       "";                          
    kb-remove-char-forward: "";                          /* Frees Ctrl+d */
    kb-secondary-copy:      "";                          /* Frees Ctrl+c */

    /* 2. Bind row movement (Holding Alt bypasses text input) */
    kb-row-left:            "Alt+h,Control+h";
    kb-row-down:            "Alt+j,Down,Control+j";
    kb-row-up:              "Alt+k,Up,Control+k";
    kb-row-right:           "Alt+l,Control+l";

    /* 3. Neovim-style half-page scrolling */
    kb-page-next:           "Page_Down,Control+d";
    kb-page-prev:           "Page_Up,Control+u";
    
    /* ── Standard Keybindings ────────────────────────────────────── */
    kb-cancel:              "Escape,Control+c,Control+bracketleft";
    
    kb-custom-1:            "Alt+u";
    kb-custom-2:            "Alt+y";
    kb-custom-3:            "Alt+t";

    scroll-method:          0;
    click-to-exit:          true;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      GLASSY COLOR PRESETS (HEX + ALPHA)                          ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
* {
    /* 95% solid base - much less transparent */
    bg-glass:             #0f0f14f2; 
    /* Slightly lighter transparent layers for inputs/tabs */
    bg-layer:             #ffffff08; 
    /* Translucent neon blue accent */
    bg-selected:          #89b4fa66; 
    /* Brighter solid blue for borders */
    border-accent:        #89b4fa88; 
    /* Urgent red */
    bg-urgent:            #f38ba866; 
    
    text-def:             #cdd6f4;
    text-dim:             #a6adc8;
    text-active:          #ffffff;
    text-urgent:          #f38ba8;

    background-color:     transparent; /* Keep global bg transparent */
    text-color:           @text-def;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      WINDOW LAYOUT                                               ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
window {
    location:           center;
    anchor:             center;
    width:              25%;
    
    background-color:   @bg-glass;
    border:             1px solid;
    border-color:       @border-accent;
    border-radius:      16px;
    padding:            20px;
}

mainbox {
    children:           [ inputbar, message, listview ];
    spacing:            15px;
    background-color:   transparent;
    border:             0;
    padding:            0;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      INPUT BAR                                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
inputbar {
    children:           [ prompt, entry ];
    spacing:            10px;
    padding:            12px;
    border-radius:      12px;
    background-color:   @bg-layer;
    text-color:         @text-def;
}

prompt {
    enabled:            true;
    background-color:   inherit;
    text-color:         @text-active;
    font:               "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @text-dim;
    background-color:   inherit;
    text-color:         @text-def;
    cursor:             text;
    vertical-align:     0.5;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      MESSAGE BAR                                                 ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
message {
    background-color:   transparent;
    border:             0;
    padding:            0;
}

textbox {
    background-color:   @bg-layer;
    text-color:         @text-dim;
    padding:            8px 12px;
    border-radius:      8px;
    markup:             true;
    font:               "JetBrainsMono Nerd Font 9";
    horizontal-align:   0.5;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      LIST VIEW                                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
listview {
    columns:            1;
    lines:              8;
    cycle:              true;
    scrollbar:          false;
    spacing:            8px;
    fixed-height:       true;
    background-color:   transparent;
    border:             0;
    padding:            0;
}

element {
    padding:            8px 12px;
    border-radius:      12px;
    cursor:             pointer;
    spacing:            10px;
    border:             0;
    height:             2.5em;
    children:           [ element-icon, element-text ];
}

element-icon {
    size:               1.4em;
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
}

element-text {
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
    highlight:          bold underline;
    cursor:             inherit;
    horizontal-align:   0;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      STATE SPECIFIC STYLING                                      ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
element normal.normal, element alternate.normal {
    background-color:   transparent;
    text-color:         @text-def;
}

element selected.normal, element selected.active {
    background-color:   @bg-selected;
    text-color:         @text-active;
    border:             1px solid;
    border-color:       @border-accent;
}

element selected.urgent {
    background-color:   @bg-urgent;
    text-color:         @text-urgent;
    border:             1px solid;
    border-color:       @text-urgent;
}

element normal.active, element alternate.active {
    background-color:   @bg-layer;
    text-color:         @text-active;
}

element normal.urgent, element alternate.urgent {
    background-color:   @bg-layer;
    text-color:         @text-urgent;
}
